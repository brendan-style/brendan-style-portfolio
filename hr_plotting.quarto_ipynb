        "title": "Home Run Prediction Error By Rating Bin"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.reset_index(drop=True)\n",
        "final_ratings_test['Rating Bin'] = final_ratings_test.rating.round()\n",
        "for i in range(len(final_ratings_test)):\n",
        "  if final_ratings_test['Rating Bin'][i] >= 8:\n",
        "    final_ratings_test['Rating Bin'][i] = '8+'\n",
        "  else:\n",
        "    continue\n",
        "df_sorted = final_ratings_test.groupby('Rating Bin').agg(Sportsbook=('under','mean'),Model=('pred_under','mean'),Actual=('hr','mean')).reset_index()\n",
        "df_sorted.Actual = 1-df_sorted.Actual\n",
        "df_sorted['Rating Bin'] = df_sorted['Rating Bin'].astype(str) \n",
        "fig = go.Figure(data=[go.Bar(name='Actual',x=df_sorted['Rating Bin'],y=df_sorted['Actual'], showlegend=False),go.Bar(name='Model',x=df_sorted['Rating Bin'],y=df_sorted['Model'], showlegend=False),go.Bar(name='Sportsbook',x=df_sorted['Rating Bin'],y=df_sorted['Sportsbook'], showlegend=False)]).update_layout(\n",
        "    barmode='group',\n",
        "    yaxis_title=\"Mean\",\n",
        "    annotations=[\n",
        "        dict(x=0.02, y=1.08, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#636EFA\">■</span> Actual'),\n",
        "        dict(x=0.16, y=1.08, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#EF553B\">■</span> Model'),\n",
        "        dict(x=0.35, y=1.08, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#00CC96\">■</span> Sportsbook'),\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "#.update_layout(legend=dict(\n",
        "#       orientation=\"h\",yanchor=\"top\",y=.99,xanchor=\"left\",\n",
        "#      x=.01),margin=dict(t=40))\n",
        "fig.show()"
      ],
