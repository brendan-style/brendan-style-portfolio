    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Profit Margin by Team"
      },
      "source": [
        "import pandas as pd\n",
        "from itables import show\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "df_sorted = final_ratings_test.sort_values('date').copy()\n",
        "df_sorted = df_sorted.groupby('team').agg(profit=('profit','sum'),over_picks=('over_pick','sum'),under_picks=('under_pick','sum')).reset_index()\n",
        "df_sorted['Total Picks'] = df_sorted.over_picks + df_sorted.under_picks\n",
        "df_sorted['ROI'] = df_sorted.profit/(df_sorted['Total Picks']*10)\n",
        "df_sorted.ROI = round((df_sorted.ROI*100),1)\n",
        "df_sorted = df_sorted.sort_values(by='ROI',ascending=False)\n",
        "df_sorted = df_sorted[['team','ROI','Total Picks']]\n",
        "show(df_sorted,searching=False,ordering=True,showIndex=False,info=False)"
      ],
      "id": "ae9a116d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Distribution of Ratings"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "fig = px.histogram(final_ratings_test, x=\"rating\", nbins=20)\n",
        "fig.show()"
      ],
      "id": "6da93b35",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Profit Margin By Bet Type"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.query('over_pick != 0 or under_pick != 0')\n",
        "final_ratings_test['type'] = final_ratings_test.apply(lambda row: 'Over' if row['over_pick'] ==1 else 'Under', axis = 1)\n",
        "df_sorted = final_ratings_test.groupby('type').agg(profit=('profit','sum'),opicks=('over_pick','sum'),upicks=('under_pick','sum')).reset_index()\n",
        "df_sorted['roi'] = round((df_sorted.profit/(df_sorted.opicks+df_sorted.upicks)*10),1)\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df_sorted['type'],\n",
        "    y=df_sorted['roi'],width=[0.3,0.3]\n",
        ")).update_layout(yaxis_title=\"ROI\")"
      ],
      "id": "aafe090e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Row\n"
      ],
      "id": "1e6af37c"
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Cumulative Units of Profit for Test Data"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "df_sorted = final_ratings_test.sort_values('date').copy()\n",
        "df_sorted['date'] = df_sorted['date'].astype(str)\n",
        "df_sorted = df_sorted.groupby('date').agg(profit=('profit','sum'),over_picks=('over_pick','sum'),under_picks=('under_pick','sum')).reset_index()\n",
        "df_sorted['cumulative_profit'] = df_sorted['profit'].cumsum()\n",
        "df_sorted['cumulative_profit']= df_sorted['cumulative_profit']/10\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=df_sorted['date'],\n",
        "    y=df_sorted['cumulative_profit'],\n",
        "    mode='lines',\n",
        "    line=dict(color='steelblue', width=3)\n",
        ")).update_layout(yaxis_title=\"Units\",\n",
        "    xaxis=dict(type='category', tickangle=45, nticks=10)\n",
        ")"
      ],
      "id": "b85823a3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Profit Margin By Pitch/Batter Matchup"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.query('stand !=\"S\"').reset_index(drop=True)\n",
        "final_ratings_test['matchup'] = 'zero'\n",
        "for i in range(len(final_ratings_test)):\n",
        "  if final_ratings_test.p_throws[i] == 'L' and final_ratings_test.stand[i] == 'L':\n",
        "    final_ratings_test.matchup[i] = 'L/L'\n",
        "  elif final_ratings_test.p_throws[i] == 'L' and final_ratings_test.stand[i] == 'R':\n",
        "    final_ratings_test.matchup[i] = 'L/R'\n",
        "  elif final_ratings_test.p_throws[i] == 'R' and final_ratings_test.stand[i] == 'L':\n",
        "    final_ratings_test.matchup[i] = 'R/L'\n",
        "  else:\n",
        "    final_ratings_test.matchup[i] = 'R/R'\n",
        "df_sorted = final_ratings_test.groupby('matchup').agg(profit=('profit','sum'),over_picks=('over_pick','sum'),under_picks=('under_pick','sum')).reset_index()\n",
        "df_sorted['picks'] = df_sorted.under_picks + df_sorted.over_picks\n",
        "df_sorted['ROI'] = (df_sorted.profit/df_sorted.picks)*10\n",
        "df_sorted = df_sorted.sort_values(by='ROI',ascending=False)\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df_sorted['matchup'],\n",
        "    y=df_sorted['ROI'],width=[.3,.3,.3,.3]\n",
        ")).update_layout(yaxis_title=\"ROI\")"
      ],
      "id": "4faf83ff",
      "execution_count": null,
      "outputs": []
    },
