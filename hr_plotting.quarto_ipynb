    {
      "cell_type": "code",
      "metadata": {
        "title": "Profit By Stadium"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.query('over_pick == 1')\n",
        "df_sorted = final_ratings_test.groupby('home').agg(profit=('profit','sum'),picks=('over_pick','sum')).reset_index()\n",
        "df_sorted.profit = df_sorted.profit/10\n",
        "df_sorted = df_sorted.sort_values(by='profit',ascending=False)\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df_sorted['home'],\n",
        "    y=df_sorted['profit']\n",
        ")).update_layout(yaxis_title=\"Profit (Units)\").update_xaxes(tickangle=300)"
      ],
      "id": "a7ca912d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Home Run Prediction Error By Rating Bin"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.reset_index(drop=True)\n",
        "final_ratings_test['Rating Bin'] = final_ratings_test.rating.round()\n",
        "for i in range(len(final_ratings_test)):\n",
        "  if final_ratings_test['Rating Bin'][i] >= 8:\n",
        "    final_ratings_test['Rating Bin'][i] = '8+'\n",
        "  else:\n",
        "    continue\n",
        "df_sorted = final_ratings_test.groupby('Rating Bin').agg(Sportsbook=('over','mean'),Model=('pred_over','mean'),Actual=('hr','mean')).reset_index()\n",
        "df_sorted['Rating Bin'] = df_sorted['Rating Bin'].astype(str) \n",
        "fig = go.Figure(data=[go.Bar(name='Actual',x=df_sorted['Rating Bin'],y=df_sorted['Actual'], showlegend=False),go.Bar(name='Model',x=df_sorted['Rating Bin'],y=df_sorted['Model'], showlegend=False),go.Bar(name='Sportsbook',x=df_sorted['Rating Bin'],y=df_sorted['Sportsbook'], showlegend=False)]).update_layout(\n",
        "    barmode='group',\n",
        "    yaxis_title=\"Mean\",\n",
        "    annotations=[\n",
        "        dict(x=0.02, y=1.08, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#636EFA\">■</span> Actual'),\n",
        "        dict(x=0.16, y=1.08, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#EF553B\">■</span> Model'),\n",
        "        dict(x=0.35, y=1.08, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#00CC96\">■</span> Sportsbook'),\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "#.update_layout(legend=dict(\n",
        "#       orientation=\"h\",yanchor=\"top\",y=.99,xanchor=\"left\",\n",
        "#      x=.01),margin=dict(t=40))\n",
        "fig.show()"
      ],
      "id": "495c593d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Row\n"
      ],
      "id": "d229f951"
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Profit Margin By Edge Bin"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.query('over_pick == 1')\n",
        "final_ratings_test['over%'] = final_ratings_test.apply(lambda row: 'Over 5.5% Edge' if row['over_diff'] >= .055 else 'Under 5.5% Edge', axis = 1)\n",
        "df_sorted = final_ratings_test.groupby('over%').agg(profit=('profit','sum'),picks=('over_pick','sum')).reset_index()\n",
        "df_sorted['roi'] = round((df_sorted.profit/df_sorted.picks*10),1)\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df_sorted['over%'],\n",
        "    y=df_sorted['roi'],width=[.3,.3]\n",
        ")).update_layout(yaxis_title=\"ROI\")"
      ],
      "id": "6e37766b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Distribution of Bets By Rating Bin"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.query('over_pick == 1')\n",
        "final_ratings_test = final_ratings_test.reset_index(drop=True)\n",
        "final_ratings_test['Rating Bin'] = final_ratings_test.rating.round()\n",
        "for i in range(len(final_ratings_test)):\n",
        "  if final_ratings_test['Rating Bin'][i] >= 8:\n",
        "    final_ratings_test['Rating Bin'][i] = '8+'\n",
        "  else:\n",
        "    continue\n",
        "df_sorted = final_ratings_test.groupby('Rating Bin').agg(profit=('profit','sum'),picks=('over_pick','sum')).reset_index()\n",
        "df_sorted['roi'] = round((df_sorted.profit/df_sorted.picks*10),1)\n",
        "df_sorted.profit = df_sorted.profit/10\n",
        "fig = go.Figure(data=[go.Pie(\n",
        "    labels=df_sorted['Rating Bin'],\n",
        "    values=df_sorted.picks,\n",
        "    showlegend=False,\n",
        "    marker=dict(colors=['#F4845F', '#8338EC', '#06D6A0'])\n",
        ")]).update_layout(\n",
        "    annotations=[\n",
        "        dict(x=0.04, y=1.1, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#F4845F\">■</span> 6'),\n",
        "        dict(x=0.14, y=1.1, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#8338EC\">■</span> 7'),\n",
        "        dict(x=0.24, y=1.1, xref='paper', yref='paper', showarrow=False,\n",
        "             text='<span style=\"color:#06D6A0\">■</span> 8+'),\n",
        "    ]\n",
        ")\n",
        "fig.show()"
      ],
      "id": "3a14bfb7",
      "execution_count": null,
      "outputs": []
    },
