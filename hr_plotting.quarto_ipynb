    {
      "cell_type": "code",
      "metadata": {
        "title": "Profit By Rating Bin"
      },
      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "final_ratings_test = pd.read_csv('v2_test_ratings.csv')\n",
        "final_ratings_test = final_ratings_test.query('under_pick == 1')\n",
        "final_ratings_test['Rating Bin'] = final_ratings_test.rating.round()\n",
        "df_sorted = final_ratings_test.groupby('Rating Bin').agg(profit=('profit','sum'),picks=('under_pick','sum')).reset_index()\n",
        "df_sorted['roi'] = round((df_sorted.profit/df_sorted.picks*10),1)\n",
        "df_sorted.profit = df_sorted.profit/10\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df_sorted['Rating Bin'],\n",
        "    y=df_sorted['profit'], marker_color='darkorange'\n",
        ")).update_layout(yaxis_title=\"Profit (Units)\")"
      ],
