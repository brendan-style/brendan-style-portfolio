        "  warning: false\n",
        "---\n",
        "\n",
        "\n",
        "# Example 1\n",
        "\n",
        "## Sorted list of QB's with most air yards\n",
        "\n",
        "### The Input\n",
        "\n",
        "```         \n",
        "SELECT players.first_name, players.last_name, \n",
        "       SUM(pass_stats.amount) AS total_air_yards\n",
        "FROM pass_stats \n",
        "JOIN players ON pass_stats.player_id = players.player_id\n",
        "WHERE stat_type = 'air_yards'\n",
        "GROUP BY players.player_id\n",
        "ORDER BY total_air_yards DESC\n",
        "```\n",
        "\n",
        "### The Result\n"
      ],
      "id": "814c406c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sqlite3 as sq\n",
        "import pandas as pd\n",
        "from itables import show\n",
        "db = sq.connect('nfl_players.db')\n",
        "records=pd.read_sql(\"\"\"\n",
        "    select players.first_name, players.last_name, sum(pass_stats.amount) as total_air_yards\n",
        "    from pass_stats join players ON pass_stats.player_id = players.player_id\n",
        "    where stat_type = \"air_yards\"\n",
        "    group by players.player_id\n",
        "    order by total_air_yards desc\n",
        "    \"\"\",db)\n",
        "show(records,searching=False,ordering=True,showIndex=False,info=False)"
      ],
      "id": "f6126e2a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Example 2\n",
        "\n",
        "## Average rushing YPA by number of box defenders\n",
        "\n",
        "### The Input\n",
        "\n",
        "```         \n",
        "SELECT round(avg(r.amount),1) as YPA,r.defenders_in_box as Box_Defenders\n",
        "FROM rush_stats r join players p ON p.player_id = r.player_id\n",
        "WHERE stat_type = \"rushing_yards\" and Box_Defenders is NOT NULL\n",
        "GROUP BY Box_Defenders\n",
        "```\n",
        "\n",
        "### The Result\n"
      ],
      "id": "1b872198"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import sqlite3 as sq\n",
        "import plotly.graph_objects as go\n",
        "db = sq.connect('nfl_players.db')\n",
        "records=pd.read_sql(\"\"\"\n",
        "SELECT round(avg(r.amount),1) as YPA,r.defenders_in_box as Box_Defenders\n",
        "FROM rush_stats r join players p ON p.player_id = r.player_id\n",
        "where stat_type = \"rushing_yards\" and Box_Defenders is NOT NULL\n",
        "group by Box_Defenders\n",
        "    \"\"\",db)\n",
        "\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=records['Box_Defenders'],\n",
        "    y=records['YPA'],\n",
        "    mode='lines',\n",
        "    line=dict(color='steelblue', width=3)\n",
        ")).update_layout(xaxis_title=\"Box Defenders\",yaxis_title=\"YPA\")"
      ],
      "id": "72e5b343",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Example 3\n",
        "\n",
        "## Using a View to plot team's average offensive output\n",
        "\n",
        "### The Input\n",
        "\n",
        "#### View - \"passing_epa_by_team\"\n",
        "\n",
        "```         \n",
        "SELECT round(avg(ps.amount),3) as Pass_EPA, p.team as Team\n",
        "FROM pass_stats ps JOIN players p on p.player_id=ps.player_id\n",
        "WHERE stat_type = 'epa'\n",
        "GROUP BY p.team\n",
        "ORDER BY Pass_EPA desc\n",
        "```\n",
        "\n",
        "#### View - \"rushing_epa_by_team\"\n",
        "\n",
        "```         \n",
        "SELECT round(avg(r.amount),3) as Rush_EPA, p.team as Team\n",
        "FROM rush_stats r \n",
        "JOIN players p ON p.player_id = r.player_id\n",
        "WHERE stat_type = \"epa\"\n",
        "GROUP BY p.team\n",
        "ORDER BY Rush_EPA Desc\n",
        "```\n",
        "\n",
        "#### Query\n",
        "\n",
        "```         \n",
        "SELECT p.Team, p.Pass_EPA, r.Rush_EPA\n",
        "FROM passing_epa_by_team p\n",
        "JOIN rushing_epa_by_team r ON p.Team = r.Team\n",
        "```\n",
        "\n",
        "### The Result\n"
      ],
      "id": "55d10f6c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import sqlite3 as sq\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "db = sq.connect('nfl_players.db')\n",
        "records=pd.read_sql(\"\"\"\n",
        "    SELECT p.Team, p.Pass_EPA, r.Rush_EPA\n",
        "    FROM passing_epa_by_team p\n",
        "    JOIN rushing_epa_by_team r ON p.Team = r.Team\n",
        "    \"\"\",db)\n",
        "avg_pass = records['Pass_EPA'].mean()\n",
        "avg_rush = records['Rush_EPA'].mean()\n",
        "ax=records.plot.scatter(x=\"Pass_EPA\",y=\"Rush_EPA\")\n",
        "for i, txt in enumerate(records['Team']):\n",
        "    ax.annotate(txt, (records['Pass_EPA'].iloc[i], records['Rush_EPA'].iloc[i]), \n",
        "            xytext=(5,5), textcoords='offset points')\n",
        "\n",
        "plt.axhline(y=avg_rush, color='r', linestyle='--')\n",
        "plt.axvline(x=avg_pass, color='r', linestyle='--')\n",
        "ax.text(0.02, 0.98, \"--- League Average\", transform=ax.transAxes, \n",
        "        color='r', fontsize=20, verticalalignment='top');\n",
        "fig=plt.gcf().set_size_inches(20,10);"
      ],
      "id": "349c5157",
      "execution_count": null,
      "outputs": []
    }
